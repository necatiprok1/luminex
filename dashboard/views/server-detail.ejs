<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= guild.name %> | Yönetim</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #5865F2;
            --primary-dark: #4752C4;
            --secondary: #EB459E;
            --accent: #57F287;
            --warning: #FEE75C;
            --danger: #ED4245;
            --dark: #0f172a;
            --dark-xl: #1e293b;
            --glass: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.08);
        }
        
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: var(--dark);
            color: white;
            min-height: 100vh;
        }
        
        .page-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        .guild-header {
            background: linear-gradient(135deg, rgba(88, 101, 242, 0.15) 0%, rgba(235, 69, 158, 0.1) 100%);
            border: 1px solid rgba(88, 101, 242, 0.2);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 24px;
        }
        
        .guild-icon-large {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            object-fit: cover;
            border: 2px solid rgba(88, 101, 242, 0.3);
        }
        
        .guild-title h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 0;
            background: linear-gradient(135deg, #fff 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .guild-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
            gap: 16px;
            margin-top: 20px;
        }
        
        /* Background Animation */
        .bg-animations {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        
        .glow-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.12;
            animation: orbFloat 20s ease-in-out infinite;
        }
        
        .orb-1 {
            width: 500px;
            height: 500px;
            background: var(--primary);
            top: -150px;
            right: -150px;
        }
        
        .orb-2 {
            width: 400px;
            height: 400px;
            background: var(--secondary);
            bottom: -100px;
            left: -100px;
            animation-delay: -10s;
        }
        
        @keyframes orbFloat {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(30px, 30px) scale(1.1); }
        }
        
        /* Navbar */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 100;
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding: 16px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 24px;
            font-weight: 800;
            color: white;
            text-decoration: none;
        }
        
        .navbar-brand .logo-icon {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }
        
        .navbar-brand span {
            background: linear-gradient(135deg, #fff 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .navbar-nav {
            display: flex;
            gap: 12px;
            align-items: center;
        }
        
        .nav-link {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 500;
            font-size: 14px;
            transition: all 0.3s ease;
        }
        
        .nav-link:hover, .nav-link.active {
            color: white;
            background: rgba(255, 255, 255, 0.1);
        }
        
        .btn-primary {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 10px 24px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 14px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(88, 101, 242, 0.4);
        }
        
        .page-container {
            position: relative;
            z-index: 1;
            max-width: 1400px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        
        .glass-box {
            background: linear-gradient(135deg, rgba(255, 255, 255, 0.02) 0%, rgba(255, 255, 255, 0.01) 100%);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 32px;
            padding: 50px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }
        
        .guild-header {
            background: linear-gradient(135deg, rgba(88, 101, 242, 0.15) 0%, rgba(235, 69, 158, 0.1) 100%);
            border: 1px solid rgba(88, 101, 242, 0.2);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 24px;
        }
        
        .guild-icon-large {
            width: 80px;
            height: 80px;
            border-radius: 20px;
            object-fit: cover;
            border: 2px solid rgba(88, 101, 242, 0.3);
        }
        
        .guild-title h1 {
            font-size: 28px;
            font-weight: 800;
            margin: 0;
            background: linear-gradient(135deg, #fff 0%, var(--primary) 100%);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        
        .guild-title p {
            color: rgba(255, 255, 255, 0.6);
            font-size: 14px;
            margin: 8px 0 0 0;
        }
        
        /* Tabs */
        .tabs-nav {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-bottom: 30px;
            background: rgba(255, 255, 255, 0.03);
            padding: 8px;
            border-radius: 16px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .tab-btn {
            background: transparent;
            border: none;
            color: rgba(255, 255, 255, 0.6);
            padding: 12px 24px;
            border-radius: 12px;
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        
        .tab-btn:hover {
            background: rgba(255, 255, 255, 0.05);
            color: white;
        }
        
        .tab-btn.active {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        .tab-content h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .tab-content h2 i {
            color: var(--primary);
        }
        
        /* Settings */
        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.3s ease;
        }
        
        .setting-row:hover {
            background: rgba(255, 255, 255, 0.02);
            margin: 0 -16px;
            padding: 20px 16px;
            border-radius: 12px;
        }
        
        .setting-row:last-child {
            border-bottom: none;
        }
        
        .setting-info h4 {
            font-size: 16px;
            font-weight: 600;
            color: white;
            margin-bottom: 4px;
        }
        
        .setting-info p {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.5);
        }
        
        .select-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            padding: 12px 16px;
            color: white;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .select-box:hover {
            border-color: rgba(88, 101, 242, 0.4);
        }
        
        .select-box option {
            background: var(--dark);
            color: white;
        }
        
        .btn-save {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: white;
            padding: 16px 32px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 16px;
            cursor: pointer;
            border: none;
            transition: all 0.3s ease;
            margin-top: 24px;
        }
        
        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(88, 101, 242, 0.4);
        }
        
        /* Switch Toggle */
        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 26px;
        }
        
        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: rgba(255, 255, 255, 0.1);
            transition: 0.3s;
            border-radius: 26px;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .slider:before {
            position: absolute;
            content: "";
            height: 20px;
            width: 20px;
            left: 3px;
            bottom: 2px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }
        
        input:checked + .slider {
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            border-color: transparent;
        }
        
        input:checked + .slider:before {
            transform: translateX(24px);
        }
        
        /* Responsive */
        @media (max-width: 768px) {
            .navbar {
                padding: 16px 20px;
            }
            
            .page-container {
                padding: 24px 16px;
            }
            
            .glass-box {
                padding: 32px 20px;
            }
            
            .guild-header {
                flex-direction: column;
                text-align: center;
                padding: 24px;
            }
            
            .tabs-nav {
                flex-direction: column;
            }
            
            .tab-btn {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="bg-animations">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
    </div>
    
    <nav class="navbar">
        <a href="/" class="navbar-brand">
            <div class="logo-icon">L</div>
            <span>Luminex</span>
        </a>
        <div class="navbar-nav">
            <a href="/servers" class="nav-link">Sunucularım</a>
            <a href="/auth/logout" class="btn-primary"><i class="fas fa-sign-out-alt"></i> Çıkış Yap</a>
        </div>
    </nav>
    
    <div class="page-container">
        <div class="glass-box">
            <div class="guild-header">
                <img src="<%= guild.iconURL() || 'https://cdn.discordapp.com/embed/avatars/0.png' %>" alt="Icon" class="guild-icon-large">
                <div class="guild-title">
                    <h1><%= guild.name %></h1>
                    <p>Sunucu ID: <%= guild.id %></p>
                </div>
            </div>

            <div class="settings-section">
                <!-- Tab Navigation -->
                <div class="tabs-nav">
                        <button class="tab-btn active" data-tab="general">
                            <i class="fas fa-sliders-h"></i> Genel Ayarlar
                        </button>
                        <button class="tab-btn" data-tab="voice">
                            <i class="fas fa-microphone"></i> Ses Kanalları
                        </button>
                        <button class="tab-btn" data-tab="moderation">
                            <i class="fas fa-gavel"></i> Moderasyon
                        </button>
                        <button class="tab-btn" data-tab="commands">
                            <i class="fas fa-terminal"></i> Komutlar
                        </button>
                        <button class="tab-btn" data-tab="profiles">
                            <i class="fas fa-users"></i> Kullanıcılar
                        </button>
                    </div>

                <!-- TAB 1: General Settings -->
                <div id="general-tab" class="tab-content active">
                    <h2><i class="fas fa-sliders-h"></i> Yönetim Masası</h2>
                    <form action="/server/<%= guild.id %>/update" method="POST">
                        <div class="setting-row">
                            <div class="setting-info">
                                <h4>Yapay Zeka (AI) Modu</h4>
                                <p>Botun kanallardaki aktifliğine izin verin.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="aiMod" <%=settings.aiMod ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-info">
                                <h4>Proaktif Analiz (Reflection)</h4>
                                <p>Botun sunucu durumunu analiz edip sohbet başlatması.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="proactiveMod" <%=settings.proactiveMod ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-info">
                                <h4>Seviye & XP Sistemi</h4>
                                <p>Üyelerin sohbette XP kazanmasını kontrol eder.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="levelMod" <%=settings.levelMod ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-info">
                                <h4>Log Sistemi Koruma</h4>
                                <p>Sunucu olaylarının log kanalına gönderilmesi.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="logMod" <%=settings.logMod ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-info">
                                <h4>Küfür Engel</h4>
                                <p>Akıllı küfür filtresini açar/kapatır.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="kufurEngel" <%=settings.kufurEngel ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-row">
                            <div class="setting-info">
                                <h4>Reklam Engel</h4>
                                <p>Link ve reklam korumasını aktif eder.</p>
                            </div>
                            <label class="switch">
                                <input type="checkbox" name="reklamEngel" <%=settings.reklamEngel ? 'checked' : '' %>>
                                <span class="slider"></span>
                            </label>
                        </div>

                        <div class="setting-row" style="flex-direction: column; align-items: flex-start; gap: 10px;">
                            <div class="setting-info">
                                <h4>Otomatik Rol (Otorol)</h4>
                                <p>Yeni katılan kullanıcılara verilecek rol.</p>
                            </div>
                            <select name="otorol" class="select-box" style="width: 100%;">
                                <option value="none">--- Rol Seçin ---</option>
                                <% roles.forEach(role=> { %>
                                    <option value="<%= role.id %>" <%=settings.otorolId===role.id ? 'selected' : '' %>>
                                        <%= role.name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <div class="setting-row" style="flex-direction: column; align-items: flex-start; gap: 10px;">
                            <div class="setting-info">
                                <h4>Hoşgeldin Mesaj Kanalı</h4>
                                <p>Giriş-çıkış mesajlarının kanalı.</p>
                            </div>
                            <select name="welcomeChannel" class="select-box" style="width: 100%;">
                                <option value="none">--- Kanal Seçin ---</option>
                                <% textChannels.forEach(chan=> { %>
                                    <option value="<%= chan.id %>" <%=settings.hosgeldinKanalId===chan.id ? 'selected'
                                        : '' %>># <%= chan.name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <div class="setting-row"
                            style="flex-direction: column; align-items: flex-start; gap: 10px; border-bottom: none;">
                            <div class="setting-info">
                                <h4>Log Kayıt Kanalı</h4>
                                <p>Tüm logların atılacağı kanal.</p>
                            </div>
                            <select name="logChannel" class="select-box" style="width: 100%;">
                                <option value="none">--- Kanal Seçin ---</option>
                                <% textChannels.forEach(chan=> { %>
                                    <option value="<%= chan.id %>" <%=settings.logKanalId===chan.id ? 'selected' : '' %>
                                        ># <%= chan.name %>
                                    </option>
                                    <% }); %>
                            </select>
                        </div>

                        <button type="submit" class="btn-save">Değişiklikleri Kaydet</button>
                    </form>
                </div>

                <!-- Detaylı İstatistikler -->
                <div class="data-section" style="display: flex; flex-direction: column; gap: 30px;">
                    <!-- Moderasyon Günlükleri -->
                    <div class="settings-card" style="background: rgba(237, 66, 69, 0.05);">
                        <h2><i class="fas fa-shield-alt"></i> Moderasyon Günlüğü</h2>
                        <% if(modLogs && modLogs.length> 0) { %>
                            <div class="log-list">
                                <% modLogs.forEach(log=> { %>
                                    <div class="log-item"
                                        style="padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.9rem;">
                                        <div style="display: flex; justify-content: space-between;">
                                            <span class="badge"
                                                style="background: var(--primary-color); padding: 2px 6px; border-radius: 4px; font-size: 0.7rem;">
                                                <%= log.action %>
                                            </span>
                                            <span class="text-muted" style="font-size: 0.7rem;">
                                                <%= new Date(log.timestamp).toLocaleString('tr-TR') %>
                                            </span>
                                        </div>
                                        <div style="margin-top: 5px;">
                                            <strong>Moderatör:</strong>
                                            <%= log.moderatorTag %> <br>
                                                <% if(log.targetTag) { %> <strong>Hedef:</strong>
                                                    <%= log.targetTag %> <br>
                                                        <% } %>
                                                            <% if(log.reason) { %> <strong>Sebep:</strong>
                                                                <%= log.reason %> <br>
                                                                    <% } %>
                                                                        <% if(log.content) { %> <em
                                                                                style="color: var(--text-muted);">"<%=
                                                                                    log.content %>"</em>
                                                                            <% } %>
                                        </div>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } else { %>
                                <p class="text-muted">Henüz moderasyon kaydı yok.</p>
                                <% } %>
                    </div>

                    <!-- Seviye Liderleri -->
                    <div class="settings-card" style="background: rgba(88, 101, 242, 0.05);">
                        <h2><i class="fas fa-trophy"></i> En Aktif Üyeler (XP)</h2>
                        <% if(leaderboard && leaderboard.length> 0) { %>
                            <div class="leaderboard-list">
                                <% leaderboard.forEach((user, index)=> { %>
                                    <div class="leader-item"
                                        style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                                        <span><strong>#<%= index + 1 %></strong>
                                            <%= user.username %>
                                        </span>
                                        <span class="text-muted">
                                            <%= user.totalXP.toLocaleString() %> XP
                                        </span>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } else { %>
                                <p class="text-muted">Veri yok.</p>
                                <% } %>
                    </div>

                    <!-- Aktivite Grafiği -->
                    <div class="settings-card" style="background: rgba(0,0,0,0.15);">
                        <h2><i class="fas fa-chart-pie"></i> Kanal Aktivitesi</h2>
                        <% if(topChannels && topChannels.length> 0) { %>
                            <div class="chart-mock">
                                <% topChannels.forEach((chan, index)=> { %>
                                    <div class="bar-item">
                                        <span class="bar-label">#<%= chan.name %></span>
                                        <div class="bar-container">
                                            <% const percentage=topChannels[0].count> 0 ? Math.round((chan.count /
                                                topChannels[0].count) * 100) : 0; %>
                                                <div class="bar-fill"
                                                    style="--bar-width: <%= percentage %>%; width: var(--bar-width);">
                                                </div>
                                        </div>
                                        <span class="bar-value">
                                            <%= chan.count %> MSJ
                                        </span>
                                    </div>
                                    <% }); %>
                            </div>
                            <% } else { %>
                                <p class="text-muted">Veri yok.</p>
                                <% } %>
                    </div>
                </div>
            </div> <!-- End data-section -->
        </div> <!-- End general-tab -->

        <!-- TAB 2: Voice Channels -->
        <div id="voice-tab" class="tab-content">
            <div class="settings-card">
                <h2><i class="fas fa-microphone"></i> Ses Kanalları Yönetimi</h2>
                <div id="voice-channels-list" class="settings-grid">
                    <div class="loading-text">Ses kanalları yükleniyor...</div>
                </div>
                <button id="btn-create-voice" class="btn-save" style="margin-top: 20px;">
                    <i class="fas fa-plus"></i> Yeni Ses Kanalı Oluştur
                </button>
            </div>
        </div>

        <!-- TAB 3: Moderation -->
        <div id="moderation-tab" class="tab-content">
            <div class="settings-card">
                <h2><i class="fas fa-gavel"></i> Moderasyon Araçları</h2>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                    <!-- Ban Kullanıcı -->
                    <div class="mod-action-card">
                        <h3><i class="fas fa-ban"></i> Kullanıcıyı Yasakla</h3>
                        <input type="text" id="ban-user-id" placeholder="Kullanıcı ID" class="input-field">
                        <input type="text" id="ban-reason" placeholder="Sebep" class="input-field">
                        <button id="btn-ban" class="btn-save" style="width: 100%;">Yasakla</button>
                    </div>
                    
                    <!-- Kick Kullanıcı -->
                    <div class="mod-action-card">
                        <h3><i class="fas fa-user-slash"></i> Kullanıcıyı Çıkar</h3>
                        <input type="text" id="kick-user-id" placeholder="Kullanıcı ID" class="input-field">
                        <input type="text" id="kick-reason" placeholder="Sebep" class="input-field">
                        <button id="btn-kick" class="btn-save" style="width: 100%;">Çıkar</button>
                    </div>
                    
                    <!-- Warn Kullanıcı -->
                    <div class="mod-action-card">
                        <h3><i class="fas fa-exclamation-triangle"></i> Uyar</h3>
                        <input type="text" id="warn-user-id" placeholder="Kullanıcı ID" class="input-field">
                        <input type="text" id="warn-reason" placeholder="Sebep" class="input-field">
                        <button id="btn-warn" class="btn-save" style="width: 100%;">Uyar</button>
                    </div>
                    
                    <!-- Clear Messages -->
                    <div class="mod-action-card">
                        <h3><i class="fas fa-eraser"></i> Mesaj Sil</h3>
                        <select id="clear-channel-id" class="select-box">
                            <option value="">-- Kanal Seçin --</option>
                            <% textChannels.forEach(chan=> { %>
                                <option value="<%= chan.id %>"># <%= chan.name %></option>
                            <% }); %>
                        </select>
                        <input type="number" id="clear-count" placeholder="Silinecek Mesaj Sayısı (1-100)" min="1" max="100" class="input-field">
                        <button id="btn-clear" class="btn-save" style="width: 100%;">Mesajları Sil</button>
                    </div>
                </div>
                
                <!-- Moderation Logs -->
                <div style="margin-top: 30px; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px;">
                    <h3><i class="fas fa-history"></i> Moderasyon Tarihi</h3>
                    <div id="mod-logs" class="log-list">
                        <div class="loading-text">Loglar yükleniyor...</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 4: Commands -->
        <div id="commands-tab" class="tab-content">
            <div class="settings-card">
                <h2><i class="fas fa-terminal"></i> Özel Bot Komutları</h2>
                
                <!-- Create Command Form -->
                <div style="background: rgba(88,101,242,0.1); padding: 20px; border-radius: 12px; margin-bottom: 30px;">
                    <h3>Yeni Komut Oluştur</h3>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                        <input type="text" id="cmd-name" placeholder="Komut Adı (ör. merhaba)" class="input-field">
                        <input type="text" id="cmd-prefix" placeholder="Prefix (varsayılan: !)" class="input-field" value="!">
                    </div>
                    <textarea id="cmd-response" placeholder="Komut Cevabı" class="input-field" rows="3" style="margin-top: 10px;"></textarea>
                    <textarea id="cmd-description" placeholder="Açıklama (opsiyonel)" class="input-field" rows="2" style="margin-top: 10px;"></textarea>
                    <button id="btn-create-cmd" class="btn-save" style="margin-top: 10px; width: 100%;">Komut Oluştur</button>
                </div>

                <!-- Commands List -->
                <h3>Mevcut Komutlar</h3>
                <div id="commands-list" class="settings-grid">
                    <div class="loading-text">Komutlar yükleniyor...</div>
                </div>
            </div>
        </div>

        <!-- TAB 5: User Profiles -->
        <div id="profiles-tab" class="tab-content">
            <div class="settings-card">
                <h2><i class="fas fa-users"></i> Kullanıcı Profilleri & Leaderboard</h2>
                
                <!-- Leaderboard -->
                <div style="margin-bottom: 30px;">
                    <h3><i class="fas fa-trophy"></i> En Aktif Üyeler</h3>
                    <div id="leaderboard-list" class="leaderboard-list">
                        <div class="loading-text">Leaderboard yükleniyor...</div>
                    </div>
                </div>

                <!-- Server Stats -->
                <div style="background: rgba(0,0,0,0.2); padding: 20px; border-radius: 12px; margin-bottom: 30px;">
                    <h3><i class="fas fa-chart-bar"></i> Sunucu İstatistikleri</h3>
                    <div id="server-stats" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px;">
                        <div class="stat-card">
                            <div class="stat-label">Toplam Üye</div>
                            <div class="stat-value" id="stat-members">-</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Aktif Kullanıcılar</div>
                            <div class="stat-value" id="stat-active">-</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Toplam Mesajlar</div>
                            <div class="stat-value" id="stat-messages">-</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">Toplam Konuşmalar</div>
                            <div class="stat-value" id="stat-conversations">-</div>
                        </div>
                    </div>
                </div>

                <!-- User Search -->
                <div>
                    <h3><i class="fas fa-search"></i> Kullanıcı Ara</h3>
                    <input type="text" id="user-search-id" placeholder="Kullanıcı ID girin" class="input-field">
                    <button id="btn-search-user" class="btn-save">Profili Görüntüle</button>
                    <div id="user-profile-detail" style="margin-top: 20px;"></div>
                </div>
            </div>
        </div>
    </div> <!-- End tabs-content -->
            </div> <!-- End settings-section -->
        </div>
    </div>
    </div>

    <script src="/js/dashboard.js"></script>
</body>

</html>