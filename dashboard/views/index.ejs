<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= bot.username %> | Dashboard
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="<%= bot.displayAvatarURL() %>" alt="Luminex">
            <span>Luminex</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="/" class="active"><i class="fas fa-th-large"></i> <span>Genel Bakış</span></a></li>
            <li><a href="/servers"><i class="fas fa-server"></i> <span>Sunucular</span></a></li>
            <li><a href="https://github.com/necatiprok1/luminex" target="_blank"><i class="fab fa-github"></i>
                    <span>GitHub</span></a></li>
        </ul>
        <div class="sidebar-footer">
            <div class="status-indicator">
                <div class="indicator-dot <%= system.botStatus %>"></div>
                <span>Durum: <%= system.botStatus.toUpperCase() %></span>
            </div>
        </div>
    </aside>

    <main class="main-content">
        <section class="glass-box">
            <h1>Hoş Geldin, <%= bot.username %>
            </h1>
            <p class="subtitle">Luminex'in mevcut durumu ve genel istatistikleri aşağıdadır.</p>

            <div class="stats-container">
                <div class="stat-card">
                    <i class="fas fa-layer-group"></i>
                    <div class="stat-value">
                        <%= stats.servers %>
                    </div>
                    <div class="stat-label">Toplam Sunucu</div>
                </div>
                <div class="stat-card">
                    <i class="fas fa-user-friends"></i>
                    <div class="stat-value">
                        <%= stats.users.toLocaleString() %>
                    </div>
                    <div class="stat-label">Toplam Kullanıcı</div>
                </div>
                <div class="stat-card">
                    <i class="fas fa-brain"></i>
                    <div class="stat-value">
                        <%= stats.aiMsgCount.toLocaleString() %>
                    </div>
                    <div class="stat-label">AI Etkileşimi</div>
                </div>
            </div>

            <div class="monitor-section">
                <h2>Sistem Durumu</h2>
                <div class="monitor-grid">
                    <div class="monitor-item">
                        <div class="monitor-name"><i class="fas fa-clock"></i> Çalışma Süresi</div>
                        <div class="monitor-value">
                            <%= system.uptime %>
                        </div>
                    </div>
                    <div class="monitor-item">
                        <div class="monitor-name"><i class="fas fa-memory"></i> RAM Kullanımı</div>
                        <div class="monitor-value">
                            <%= system.memory %>
                        </div>
                    </div>
                    <div class="monitor-item">
                        <div class="monitor-name"><i class="fab fa-node-js"></i> Node Sürümü</div>
                        <div class="monitor-value">
                            <%= system.nodeVersion %>
                        </div>
                    </div>
                    <div class="monitor-item">
                        <div class="monitor-name"><i class="fas fa-microchip"></i> İşlemci Çekirdeği</div>
                        <div class="monitor-value">
                            <%= system.cpuCount %> Çekirdek
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <div class="bg-animations">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
    </div>
</body>

</html>