<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= bot.username %> | Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="glass-container">
        <nav>
            <div class="logo">
                <img src="<%= bot.displayAvatarURL() %>" alt="Bot Logo">
                <span><%= bot.username %></span>
            </div>
            <ul>
                <li><a href="/" class="active"><i class="fas fa-home"></i> Ana Sayfa</a></li>
                <li><a href="/servers"><i class="fas fa-server"></i> Sunucular</a></li>
                <li><a href="https://discord.gg/luminex" target="_blank"><i class="fab fa-discord"></i> Destek</a></li>
            </ul>
        </nav>

        <header>
            <h1>Yapay Zeka Destekli Yönetim Paneli</h1>
            <p>Luminex ile sunucunuzu geleceğin teknolojisiyle yönetin.</p>
        </header>

        <div class="stats-grid">
            <div class="stat-card">
                <i class="fas fa-server"></i>
                <div class="stat-info">
                    <h3><%= stats.servers %></h3>
                    <p>Sunucu</p>
                </div>
            </div>
            <div class="stat-card">
                <i class="fas fa-users"></i>
                <div class="stat-info">
                    <h3><%= stats.users %></h3>
                    <p>Kullanıcı</p>
                </div>
            </div>
            <div class="stat-card">
                <i class="fas fa-robot"></i>
                <div class="stat-info">
                    <h3><%= stats.aiMsgCount %></h3>
                    <p>AI Etkileşimi</p>
                </div>
            </div>
        </div>

        <section class="cta-section">
            <h2>Hemen Yönetmeye Başla</h2>
            <p>Sunucu ayarlarını değiştirmek ve AI analizlerini görmek için sunucularını listele.</p>
            <a href="/servers" class="btn-primary">Sunucularımı Listele</a>
        </section>
    </div>

    <div class="background-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>
    </div>
</body>
</html>
