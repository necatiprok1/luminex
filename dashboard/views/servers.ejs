<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sunucular | <%= bot.username %>
    </title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
</head>

<body>
    <aside class="sidebar">
        <div class="sidebar-logo">
            <img src="<%= bot.displayAvatarURL() %>" alt="Luminex">
            <span>Luminex</span>
        </div>
        <ul class="sidebar-menu">
            <li><a href="/"><i class="fas fa-th-large"></i> <span>Genel Bakış</span></a></li>
            <li><a href="/servers" class="active"><i class="fas fa-server"></i> <span>Sunucular</span></a></li>
            <li><a href="https://github.com/necatiprok1/luminex" target="_blank"><i class="fab fa-github"></i>
                    <span>GitHub</span></a></li>
        </ul>
    </aside>

    <main class="main-content">
        <section class="glass-box">
            <h1>Sunucularım</h1>
            <p class="subtitle">Luminex'in aktif olduğu tüm sunucuları aşağıdan yönetebilirsiniz.</p>

            <div class="guilds-grid">
                <% guilds.forEach(guild=> { %>
                    <div class="guild-card">
                        <img src="<%= guild.icon %>" class="guild-avatar" alt="<%= guild.name %>">
                        <div class="guild-name">
                            <h3>
                                <%= guild.name %>
                            </h3>
                            <div class="guild-members"><i class="fas fa-user-friends"></i>
                                <%= guild.memberCount %> Üye
                            </div>
                        </div>
                        <a href="/server/<%= guild.id %>" class="btn-manage">Yönet</a>
                    </div>
                    <% }); %>
            </div>
        </section>
    </main>

    <div class="bg-animations">
        <div class="glow-orb orb-1"></div>
        <div class="glow-orb orb-2"></div>
    </div>
</body>

</html>