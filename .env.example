# ====================================
# LUMINEX BOT CONFIGURATION
# ====================================
# Copy this file to .env and fill in your values
# WARNING: Never commit .env to git - it contains sensitive data!

# 🤖 BOT SETTINGS
TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id
BOT_PREFIX=!
BOT_STATUS=Luminex AI Bot
SHARD_COUNT=1

# 🌐 DASHBOARD SETTINGS
PORT=3000
DASHBOARD_URL=http://localhost:3000
NODE_ENV=development

# 🔐 DISCORD OAUTH2 (Dashboard Authentication)
# Get these from: https://discord.com/developers/applications
# 1. Create application
# 2. Go to OAuth2 > General
# 3. Copy Client ID and generate Client Secret
# 4. Add Redirect URI: http://localhost:3000/auth/callback (dev)
#                     https://your-domain.com/auth/callback (prod)
DISCORD_CLIENT_ID=your_bot_client_id_here
DISCORD_CLIENT_SECRET=your_bot_client_secret_here

# Session Secret - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters in production
SESSION_SECRET=generate_random_32_character_string_here

# WEBHOOK URL
WEBHOOK_URL=your_discord_webhook_url_here

# 🧠 AI SERVICE CONFIGURATION
# At least one AI service must be configured (Ollama, OpenRouter, or Gemini)

# OpenRouter (Primary - Cloud-based LM)
OPENROUTER_API_KEY=sk-or-v1-your_api_key_here
OPENROUTER_MODEL=deepseek/deepseek-chat

# Local Ollama Model
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=30000

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API (Web Search)
TAVILY_API_KEY=tvly-dev-your_api_key_here

# AI Memory & Cache Settings
HISTORY_TTL=86400000
MAX_HISTORY_SIZE=10000
CACHE_DURATION=300000

# 🗄️ DATABASE CONFIGURATION
# MongoDB Connection String
MONGO_URI=mongodb://mongodb:27017/luminex

# Redis (Optional, for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 📊 LOGGING & ANALYTICS
LOG_LEVEL=info
ERROR_WEBHOOK_URL=
ANALYTICS_ENABLED=true

# 🔒 SECURITY
ENABLE_RATE_LIMIT=true
RATE_LIMIT_WINDOW=900000
MAX_REQUESTS_PER_WINDOW=100
ENABLE_CSRF=true

# 🎯 FEATURE FLAGS
AI_ENABLED=true
MODERATION_ENABLED=true
LEVEL_SYSTEM_ENABLED=true
GIVEAWAY_SYSTEM_ENABLED=true
TICKET_SYSTEM_ENABLED=true
RAG_PIPELINE_ENABLED=true

# 🚀 SHARDING & CLUSTERING
SHARDING_ENABLED=true
SHARD_COUNT=auto
RESPAWN_DELAY=5000
SPAWN_DELAY=5000
